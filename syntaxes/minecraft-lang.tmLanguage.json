{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Minecraft Lang",
  "scopeName": "source.minecraft-lang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#pairs" }
  ],
  "repository": {
    "comments": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.minecraft-lang"
    },
    "pairs": {
      "match": "^\\s*([^=#\\s][^=]*?)\\s*=(.*)$",
      "captures": {
        "1": { "name": "entity.name.tag.key.minecraft-lang" },
        "2": { "name": "string.unquoted.value.minecraft-lang" }
      }
    }
  }
}
